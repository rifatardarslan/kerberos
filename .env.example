# KERBEROS ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# .env git'e gönderilmez (.gitignore). Kerberos önce çalıştığı dizindeki,
# sonra kurulum dizinindeki .env dosyasını okur.
# Hepsi opsiyoneldir; boş bırakılan satırlar varsayılan değeri kullanır.

# ---------------------------------------------------------------------------
# Telegram uzaktan kontrol (RC)
# ---------------------------------------------------------------------------
# İkisi de doluysa bot başlar. Boşsa Kerberos Telegram'sız çalışır.
#
# Bot token'ı: Telegram'da @BotFather → /newbot → verdiği token (123456:ABC...)
TELEGRAM_BOT_TOKEN=
# Kendi Telegram kullanıcı ID'niz (sayı). @userinfobot'a yazınca söyler.
# Bot yalnızca bu kullanıcıya yanıt verir, diğerlerini sessizce yok sayar.
TELEGRAM_ALLOWED_USER_ID=

# ---------------------------------------------------------------------------
# Ajanlar
# ---------------------------------------------------------------------------
# Şef ajan: claude | codex | opencode | agy   (varsayılan: claude)
# KERBEROS_CHIEF=claude

# Bir ajanın yanıt vermesi için beklenen süre, milisaniye (varsayılan: 180000 = 3 dk).
# Kodlama aşamasında bunun üç katı uygulanır.
# KERBEROS_TIMEOUT_MS=180000

# Claude için düşünme bütçesi (config'teki agents.claude.thinkingTokens'ı ezer)
# MAX_THINKING_TOKENS=

# ---------------------------------------------------------------------------
# Dil
# ---------------------------------------------------------------------------
# Arayüz dili: en | tr | auto   (varsayılan: en; kalıcı ayar için /config → Language)
# KERBEROS_LANG=tr

# Ajanların yanıt dili: auto (sistem dili) | tr | en | "German" gibi bir dil adı
# KERBEROS_REPLY_LANG=auto

# ---------------------------------------------------------------------------
# Diğer
# ---------------------------------------------------------------------------
# Site kontrolünde kullanılacak tarayıcı. Boşsa Chrome/Edge/Chromium kendiliğinden bulunur.
# KERBEROS_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Ayarların, prompt geçmişinin ve oturumların tutulduğu dizin (varsayılan: ~/.kerberos)
# KERBEROS_HOME=
